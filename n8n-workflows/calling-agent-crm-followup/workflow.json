{
  "name": "AI Calling Agent -> CRM -> Follow-up (demo, v2)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "lz-call-completed-demo",
        "responseMode": "responseNode",
        "options": {},
        "authentication": "headerAuth"
      },
      "id": "1",
      "name": "Webhook \u2014 Call Completed",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -900,
        0
      ],
      "webhookId": "00000000-0000-4000-8000-000000000002",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL",
          "name": "Webhook shared secret (x-webhook-secret)"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "name",
              "value": "={{ $json.body?.name ?? '' }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "phone",
              "value": "={{ $json.body?.phone ?? '' }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "email",
              "value": "={{ $json.body?.email ?? '' }}",
              "type": "string"
            },
            {
              "id": "a4",
              "name": "call_summary",
              "value": "={{ $json.body?.call_summary ?? '' }}",
              "type": "string"
            },
            {
              "id": "a5",
              "name": "intent",
              "value": "={{ $json.body?.intent ?? '' }}",
              "type": "string"
            },
            {
              "id": "a6",
              "name": "outcome",
              "value": "={{ $json.body?.outcome ?? '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "2",
      "name": "Normalize Call Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -680,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const missing = ['name', 'phone', 'call_summary'].filter(k => !String($json[k] || '').trim());\nif (missing.length) return [{ json: { valid: false, errors: missing.map(k => `${k} is required`) } }];\nconst s = ($json.call_summary || '').toLowerCase();\nconst qualified = ['demo','pricing','quote','buy','interested','book','meeting'].some(k => s.includes(k)) || ($json.outcome || '').toLowerCase() === 'qualified';\nreturn [{json:{...$json, valid: true, qualification: qualified ? 'qualified' : 'not_qualified', next_action: qualified ? 'sales_follow_up' : 'log_only', priority: s.includes('urgent') ? 'high' : 'normal'}}];"
      },
      "id": "3",
      "name": "Extract Lead Details",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -460,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{$json.qualification}}",
              "rightValue": "qualified",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4",
      "name": "Lead Qualified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        20,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://crm.example.invalid/api/contacts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ name: $json.name, phone: $json.phone, email: $json.email, intent: $json.intent, priority: $json.priority, summary: $json.call_summary }) }}",
        "options": {
          "timeout": 15000
        }
      },
      "id": "5",
      "name": "Create / Update CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        -120
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1",
              "name": "follow_up_task",
              "value": "=Call {{ $('Extract Lead Details').item.json.name }} regarding {{ $('Extract Lead Details').item.json.intent }}",
              "type": "string"
            },
            {
              "id": "f2",
              "name": "follow_up_status",
              "value": "pending",
              "type": "string"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      },
      "id": "6",
      "name": "Create Follow-up Task",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        500,
        -120
      ]
    },
    {
