        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "=Qualified call: {{ $('Extract Lead Details').item.json.name }} - {{ $('Extract Lead Details').item.json.intent }} - follow-up required"
